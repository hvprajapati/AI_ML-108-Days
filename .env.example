# ============================================
# AI ML SYLLABUS - LLM Engineering Track
# Copy this to .env and add your API keys
# ============================================
# You only need ONE of these keys to start.
# Day 61-62 can even work with just Ollama (free, local).

# OpenAI (Recommended - most widely used in course)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (Used in some advanced examples)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (Free tier available)
GOOGLE_API_KEY=your-google-api-key-here

# Groq (Fast, free tier available)
GROQ_API_KEY=your-groq-api-key-here

# Optional: LangSmith for tracing/debugging (free tier)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai-ml-syllabus
